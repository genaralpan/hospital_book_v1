# 复制为 .env 后填写真实值

# ---- LLM（默认 DeepSeek，兼容 OpenAI 协议）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的deepseek密钥
LLM_MODEL=deepseek-chat

# ---- Embedding ----
# huggingface（本地、免费、适合中文） | openai（在线 API）
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅当 EMBEDDING_PROVIDER=openai 时需要：
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_API_KEY=sk-你的openai密钥

# ---- 检索 / 切分 / 记忆（可选，留空走默认）----
# RETRIEVER_TOP_K=5
# RRF_CONSTANT=60
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# MEMORY_THRESHOLD=20
# MEMORY_KEEP_RECENT=10
